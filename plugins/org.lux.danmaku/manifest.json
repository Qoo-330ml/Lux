{
  "formatVersion": 1,
  "id": "org.lux.danmaku",
  "name": "弹幕匹配",
  "description": "匹配本地视频并获取 Bilibili 标准弹幕 XML",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": {
    "kind": "process",
    "entrypoint": "binaries/${platform}-${arch}/lux-plugin-danmaku"
  },
  "type": "danmaku",
  "category": "MEDIA",
  "supportedItemTypes": ["Movie", "Episode"],
  "capabilities": ["danmaku.match"],
  "configFields": [
    {
      "key": "providerBaseUrl",
      "label": "弹幕 API 地址",
      "type": "text",
      "required": true,
      "sensitive": true,
      "description": "Dandanplay 兼容 API 或 danmu_api 基地址，可包含脱敏 token 路径。"
    }
  ],
  "permissions": {
    "network": ["*"],
    "filesystem": []
  },
  "files": []
}
