{
  "formatVersion": 1,
  "id": "org.lux.notifier.bark",
  "name": "Bark 推送",
  "description": "通过 Bark App 把 Lux 通知推送到 iPhone",
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": {
    "kind": "process",
    "entrypoint": "binaries/${platform}-${arch}/lux-plugin-notifier-bark"
  },
  "type": "notification",
  "category": "NOTIFICATION",
  "capabilities": ["notification.send"],
  "configFields": [
    {
      "key": "secret",
      "label": "Bark 设备密钥",
      "type": "password",
      "required": true,
      "sensitive": true,
      "description": "Bark App 首页显示的设备密钥，只允许字母、数字、下划线和连字符。"
    },
    {
      "key": "serverUrl",
      "label": "Bark 服务器地址",
      "type": "text",
      "required": false,
      "defaultValue": "https://api.day.app",
      "description": "自建 Bark 服务时填写自己的 http(s) 基地址，末尾斜杠会被忽略。"
    },
    {
      "key": "group",
      "label": "分组",
      "type": "text",
      "required": false,
      "description": "可选，Bark 通知分组名称。"
    },
    {
      "key": "level",
      "label": "通知级别",
      "type": "select",
      "required": false,
      "defaultValue": "active",
      "options": [
        {"value": "active", "label": "active（默认，立即提醒）"},
        {"value": "timeSensitive", "label": "timeSensitive（时效性通知）"},
        {"value": "passive", "label": "passive（静默进入通知中心）"}
      ],
      "description": "对应对 Bark 的 level 参数。"
    },
    {
      "key": "icon",
      "label": "图标地址",
      "type": "text",
      "required": false,
      "description": "可选，http(s) 图标 URL。"
    },
    {
      "key": "sound",
      "label": "提示音",
      "type": "text",
      "required": false,
      "description": "可选，Bark 提示音名称。"
    }
  ],
  "permissions": {
    "network": ["*"],
    "filesystem": []
  },
  "files": []
}
