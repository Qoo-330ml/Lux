{
  "manifest_version": 3,
  "name": "Lux Remote Matroska Media",
  "version": "0.4.0",
  "description": "让 Lux 在不转发媒体字节的情况下播放远程 Matroska 音视频并读取内嵌文本字幕。",
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content-script.js"],
    "run_at": "document_start"
  }]
}
