LUX_HTTP_ADDR=127.0.0.1:8097
LUX_CONFIG_DIR=./config
LUX_PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,::1
RUST_LOG=luxd=info,tower_http=info
TZ=Asia/Shanghai
# Docker Compose defaults. Keep the Lux cgroup finite so memory-aware worker throttling is active.
LUX_MEMORY_LIMIT=2g
LUX_MALLOC_ARENA_MAX=2
# Only used with: docker compose --profile postgres up -d
LUX_POSTGRES_PASSWORD=
LUX_POSTGRES_DB=lux
LUX_POSTGRES_USER=lux
LUX_POSTGRES_MEMORY_LIMIT=1g
LUX_POSTGRES_SHM_SIZE=256m
# Offline SQLite -> PostgreSQL migration command. The password is environment-only.
LUX_MIGRATE_POSTGRES_HOST=postgres
LUX_MIGRATE_POSTGRES_PORT=5432
LUX_MIGRATE_POSTGRES_DATABASE=lux
LUX_MIGRATE_POSTGRES_USER=lux
LUX_MIGRATE_POSTGRES_PASSWORD=
LUX_MIGRATE_POSTGRES_SSL_MODE=disable
