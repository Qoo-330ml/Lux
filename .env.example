LUX_HTTP_ADDR=127.0.0.1:8097
LUX_CONFIG_DIR=./config
LUX_PROXY_URL=
# Filmly/网易爆米花 drops Emby auth headers when loading artwork. Set this to
# "compat" to serve untagged images without authentication; that bypasses media
# library and content-restriction checks, so only enable it on a trusted network.
# LUX_FILMLY_IMAGE_MODE=compat
# Optional database pool override for both SQLite and PostgreSQL (1-100).
# Defaults: SQLite=8, PostgreSQL=8.
# LUX_DB_MAX_CONNECTIONS=8
# Upper bound for one SQLite full VACUUM in the daily maintenance round. A full
# VACUUM rewrites the whole file and holds the write lock, so keep it short; only
# databases created before incremental auto-vacuum need it.
# LUX_SQLITE_VACUUM_TIMEOUT_SECONDS=120
# Opt in to incremental auto-vacuum for newly created databases so a large library
# deletion can return space in bounded steps. Measured cost on the deletion path is
# about 1.7x, so it stays off unless you need the space back.
# LUX_SQLITE_AUTO_VACUUM=incremental
# Finished task history retention in days (0 disables the daily purge).
# LUX_TASK_HISTORY_RETENTION_DAYS=14
# Global local index worker override (1-1024); Docker defaults are scan=4, probe=8, ffmpeg=2.
# LUX_SCAN_CONCURRENCY=4
# LUX_PROBE_CONCURRENCY=8
# LUX_FFMPEG_CONCURRENCY=2
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,::1
RUST_LOG=luxd=info,tower_http=info
TZ=Asia/Shanghai
# Docker Compose defaults. Keep the Lux cgroup finite so memory-aware worker throttling is active.
LUX_MEMORY_LIMIT=2g
LUX_MALLOC_ARENA_MAX=2
# Only used with: docker compose --profile postgres up -d
LUX_POSTGRES_PASSWORD=
LUX_POSTGRES_DB=lux
LUX_POSTGRES_USER=lux
